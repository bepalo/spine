{
  "name": "@bepalo/spine",
  "version": "3.16.31",
  "exports": {
    ".": "./mod.ts",
    "./mod.ts": "./mod.ts"
  },
  "description": "A Next-Generation Web-Standard HTTP Pipeline-based Router for TypeScript & JavaScript.",
  "license": "MIT",
  "homepage": "https://github.com/bepalo/spine",
  "repository": {
    "type": "git",
    "url": "https://github.com/bepalo/spine"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "include": ["./src/", "./tests/"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-sloppy-imports"]
    }
  },
  "fmt": {
    "include": ["./src/", "./tests/"],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "test": {
    "include": ["tests/**/*.deno.test.ts"]
  },
  "imports": {
    "@bepalo/spine": "./src/index.ts"
  },
  "keywords": [
    "router",
    "rest",
    "http",
    "https",
    "middleware",
    "backend",
    "fast",
    "efficient",
    "modern",
    "framework",
    "bun",
    "node",
    "deno",
    "workers"
  ]
}
